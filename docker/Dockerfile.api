FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1 \
    OPENBLAS_NUM_THREADS=1

WORKDIR /app

RUN apt-get update \
    && apt-get install -y --no-install-recommends libgomp1 \
    && rm -rf /var/lib/apt/lists/*

COPY pyproject.toml ./
COPY src/ ./src/
RUN pip install --no-cache-dir .

COPY configs/ ./configs/

# Documents the port this service listens on (documentation only - does not open it)
EXPOSE 8000

CMD ["uvicorn", "retail_ds.serve.api:app", "--host", "0.0.0.0", "--port", "8000"]
